        count = 0
        for item in self.incoming_dir.iterdir():
            if item.is_dir():
                # [SOVEREIGN-FORGE-LOGIC]: Sử dụng Lò đúc để đúc kỹ năng mới
                skill_id = item.name
                logic_file = item / "logic.py"
                
