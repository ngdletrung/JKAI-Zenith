/* ─── TYPOGRAPHY & PROSE ─── */
.glow-text-zenith {
  text-shadow: 0 0 15px rgba(0, 242, 255, 0.5);
}

.glow-text-jkai {
  background: linear-gradient(to right, #10b981, #34d399, #00f2ff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 8px rgba(16, 185, 129, 0.4));
  font-weight: 900;
}

.glow-text-master {
  background: linear-gradient(to right, #f59e0b, #fbbf24, #fcd34d);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.5));
  font-weight: 900;
}

.prose-xs {
  font-size: 13.5px !important;
  line-height: 1.75 !important;
}

.prose-xs code {
  font-family: 'JetBrains Mono', monospace !important;
  font-size: 0.9em !important;
  color: var(--accent-zenith) !important;
  background: rgba(0, 242, 255, 0.08) !important;
  border: 1px solid rgba(0, 242, 255, 0.1) !important;
  padding: 0.15em 0.35em !important;
  border-radius: 6px !important;
}

.prose-xs pre {
  background: rgba(0, 0, 0, 0.4) !important;
  border: 1px solid var(--glass-border) !important;
  padding: 1.25rem !important;
  border-radius: 16px !important;
  box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.2);
}

/* ─── ANIMATIONS ─── */
.animate-slide-up {
  animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 🏛️ [ZENITH-ANIMATIONS]: Hiệu ứng hơi thở cho Hội đồng thưa Master */
@keyframes breathing {
  0%, 100% { transform: scale(1) translateY(0); opacity: 0.9; }
  50% { transform: scale(1.02) translateY(-2px); opacity: 1; }
}

.animate-breathing {
  animation: breathing 4s ease-in-out infinite;
}

/* ─── MERMAID THEME ─── */
.mermaid svg {
  max-width: 100% !important;
  height: auto !important;
}

.mermaid .node rect,
.mermaid .node circle,
.mermaid .node ellipse,
.mermaid .node polygon,
.mermaid .node path {
  fill: rgba(0, 242, 255, 0.03) !important;
  stroke: rgba(0, 242, 255, 0.3) !important;
  stroke-width: 1px !important;
}

.mermaid .edgePath .path {
  stroke: rgba(0, 242, 255, 0.2) !important;
  stroke-width: 1.5px !important;
}

.mermaid .label {
  color: #fff !important;
  font-family: 'JetBrains Mono', monospace !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.08em !important;
}

/* ─── ARTIFACTS PROSE (DIMMED) ─── */
.prose-dimmed h1,
.prose-dimmed h2,
.prose-dimmed h3,
.prose-dimmed h4 {
  color: rgba(255, 255, 255, 0.8) !important;
  font-weight: 800 !important;
  letter-spacing: 0.05em !important;
}

.prose-dimmed p,
.prose-dimmed li,
.prose-dimmed span {
  color: rgba(255, 255, 255, 0.5) !important;
}

.prose-dimmed strong {
  color: rgba(0, 242, 255, 0.6) !important;
  font-weight: 700 !important;
}

/* ─── RADAR SCAN ANIMATION ─── */
.animate-radar-scan {
  animation: radar-scan 4s linear infinite;
}

@keyframes radar-scan {
  from {
    transform: translateY(-100%);
  }

  to {
    transform: translateY(100%);
  }
}

/* ─── BIO-DYNAMIC FLOW ANIMATIONS ─── */
@keyframes dash {
  from {
    stroke-dashoffset: 0;
  }

  to {
    stroke-dashoffset: -40;
  }
}

@keyframes pulse-vessel {

  0%,
  100% {
    stroke-width: 4;
    stroke-opacity: 0.15;
  }

  50% {
    stroke-width: 6;
    stroke-opacity: 0.35;
  }
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }

  100% {
    background-position: 200% 0;
  }
}

.animate-shimmer {
  animation: shimmer 2s infinite linear;
}
