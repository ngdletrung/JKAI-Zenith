                "Chào Ngài, chúng ta cùng thảo luận về các giải pháp mới nhé? ⚒️",
                "Tôi đã sẵn sàng đàm đạo. Master có ý tưởng gì cho kế hoạch hôm nay không ạ? 🏛️",
                "Mọi dữ liệu đã sẵn sàng để chúng ta cùng bàn bạc 💎.",
                "Chúng ta hãy cùng nhau kiến tạo nên những nhiệm vụ tuyệt vời! 🚀"
            ],
            "HELP": [
                "📜 [HELP]: /help, /status, /sync, /skill_search, /skill_run #ID. JKAI Zenith luôn sẵn sàng!"
            ],
            "CMD_STATUS": [
                "📊 [SYSTEM]: CPU: Optimal | RAM: Secure | GPU: Ready. Master cần kiểm tra thông số chi tiết không ạ?"
            ]
        }

        # 🎯 [ROUTING-LOGIC]: Xác định kho phản hồi phù hợp
        target_pool = "GREETING" # Mặc định
        
        if "help" in clean:
            target_pool = "HELP"
        elif "status" in clean:
            target_pool = "CMD_STATUS"
        elif any(kw in clean for kw in ["xong", "duoc", "sao roi", "the nao", "ready"]):
            target_pool = "STATUS"
        elif any(kw in clean for kw in ["lam gi", "co do", "rang", "met", "online", "thuc"]):
            target_pool = "ENGAGEMENT"
        elif any(kw in clean for kw in ["thao luan", "noi chuyen", "chat", "tam su", "ban bac"]):
            target_pool = "DISCUSSION"
            
        return random.choice(pools[target_pool])

# Sovereign Property of Master LeeTrung. JKAI Zenith Reflex Gate v1.4 🏛️💎🛡️
</file>

<file path="docker-compose.yml">
name: JKAI

services:
  # =========================
  # 🗄️ POSTGRESQL
  # =========================
  postgres:
    image: postgres:15-alpine
    container_name: postgres
    restart: unless-stopped
    env_file: .env
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - ai-network

  # =========================
  # 🧠 REDIS QUEUE (cho n8n worker)
  # =========================
  redis-queue-v2:
    image: redis:7-alpine
    container_name: redis-queue
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--maxmemory-policy", "noeviction", "--requirepass", "${REDIS_PASSWORD}"]
    volumes:
      - redis-queue-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
    networks:
      - ai-network

  # =========================
  # 🧠 REDIS AI (cho AI workers)
  # =========================
  redis-ai:
    image: redis:7-alpine
    container_name: redis-ai
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--requirepass", "${REDIS_PASSWORD}"]
    volumes:
      - redis-ai-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    ports:
      - "6379:6379"
    networks:
      - ai-network

  # =========================
  # 🔍 QDRANT VECTOR DB
  # =========================
  qdrant:
    image: qdrant/qdrant:latest
    container_name: qdrant
    restart: unless-stopped
    ports:
      - "6333:6333"
    volumes:
      - qdrant-data:/qdrant/storage
    networks:
      - ai-network

  # =========================
  # 🧠 RAG SERVICE
  # =========================
  rag-service:
    build: ./rag
    container_name: rag-service
    restart: unless-stopped
    depends_on:
      qdrant:
        condition: service_started
    command: ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
    env_file: .env
    volumes:
      - ./rag:/app
      - ./intelligence/vault/01_Knowledge:/app/knowledge_base
      - ./intelligence:/intelligence:ro
      - ./core:/shared/core:ro
    environment:
      - PYTHONPATH=/app:/shared
      - OLLAMA_HOST=http://host.docker.internal:11434
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "8000:8000"
    networks:
      - ai-network
    mem_limit: 2g
    cpus: 2

  # =========================
  # 🚀 AI TELEGRAM
  # =========================
  ai-telegram:
    build: ./services/ai-telegram
    container_name: ai-telegram
    restart: unless-stopped
    env_file: .env
    depends_on:
      - ai-control-plane
    environment:
      - AI_CONTROL_PLANE_URL=http://ai-control-plane:8000
      - PYTHONUNBUFFERED=1
    volumes:
      - ./services/ai-telegram:/app
    networks:
      - ai-network
