    # Nếu đã có data local, giữ lại
    if failure_memory:
        failure_memory._redis = redis_client
        failure_memory._qdrant = qdrant_client
    else:
        failure_memory = FailureMemory(redis_client=redis_client, qdrant_client=qdrant_client)
