            continue
            
        print(f"Scanning: {full_path}")
        for root, _, files in os.walk(full_path):
            if any(d in root for d in ['.git', '__pycache__', 'node_modules', 'dist', 'tokenizer', 'data', 'venv']):
                continue
            for file in files:
