def clear_navigation_noise(text: str) -> str:
    """
    🧹 [NEURAL-PURIFIER]: Loại bỏ toàn bộ nhiễu navigation bar, footer, link menu
    để giữ lại văn bản bài viết cốt lõi nhất.
    """
    if not text:
