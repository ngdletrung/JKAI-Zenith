    def _parse_rules(self):
        try:
            with open(self.rules_path, 'r', encoding='utf-8') as f:
                content = f.read()
            new_r_cache = {}
            self.global_params = {}
            self.profiles = {}
            lines = content.split('\n')
            in_section_3 = False
            in_section_25 = False
            headers = []
            
            for line in lines:
                line = line.strip()
