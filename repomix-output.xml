            return {"status": "success", "path": path}
        elif action == "write_excel":
            path = self.write_excel(kwargs.get("data"), filename=kwargs.get("filename", "Data"))
            return {"status": "success", "path": path}
        return {"status": "error", "msg": f"Hành động '{action}' không được hỗ trợ."}

