    async def _read_file_content(self, file_path: Path) -> str:
        """⚡ INTEL EXTRACTION: Utilizing Core Converter."""
        try:
            # 📄 [CONVERTING] Triết xuất tri thức qua Core Converter
            return await converter.to_markdown(str(file_path))
