        master_payload = json.dumps({"id": f"reflex_m_{fake_tid}", "tag": master_tag, "msg": goal_raw, "ts": time.time(), "task_id": fake_tid, "type": "user"})
        redis_safe(lambda r: r.publish("monitor:log_channel", master_payload))
        
