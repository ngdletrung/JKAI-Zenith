    }
  },
  {
    id: 'executor-alpha', role: 'executor-alpha', label: 'Ban Thực Thi Alpha', side: 'left', order: 5,
    posMatrix: {
      IDLE: { x: '62%', y: '80%', size: '75%', z: 40 },
      RUNNING: { x: '52%', y: '80%', size: '90%', z: 40 },
      STRESSED: { x: '62%', y: '80%', size: '75%', z: 40 },
