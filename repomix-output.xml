                if line.startswith('- **') and ':' in line:
                    # Hỗ trợ cả **KEY**: và **KEY:** 
                    clean_line = line[4:].replace('**:', ':').replace('**', '')
                    if ':' in clean_line:
                        p_key, p_val = clean_line.split(':', 1)
