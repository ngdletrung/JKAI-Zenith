class HardwareTarget(str, Enum):
    """
    ALPHA = GPU : Reasoning sâu, viết code, phân tích ngữ nghĩa, sinh văn bản.
    BETA  = CPU : I/O bound — đọc/ghi file, web search, gọi API, convert format.
