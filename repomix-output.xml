                raise e
            # Thêm Jitter ngẫu nhiên vào thời gian chờ tái thử (ví dụ: wait + 1.0s đến 3.0s)
            wait = min((i + 1) * 3, 30) + random.uniform(1.0, 3.0)
            print(f"⚠️ [TELE-RETRY]: Mất kết nối hoặc bị giới hạn. Đang thử lại sau {wait:.2f}s... (Lần {i+1})")
