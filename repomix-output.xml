                                if isinstance(r, dict):
                                    cleaned_r = {
                                        "title": r.get("title", ""),
                                        "url": r.get("url", ""),
                                        "content": (r.get("content") or r.get("snippet") or "")[:400]
                                    }
                                    cleaned_results.append(cleaned_r)
                            cleaned_output["results"] = cleaned_results
                        # Trường hợp kết quả cào trang Jina (chứa "content")
