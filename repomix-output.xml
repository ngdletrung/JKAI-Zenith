body {
  margin: 0;
  font-family: 'Outfit', 'Inter', sans-serif;
  -webkit-font-smoothing: antialiased;
  background: var(--bg-deep);
  color: #e2e8f0;
  overflow: hidden;
  letter-spacing: -0.015em;
}

/* ─── PREMIUM MINIMALIST SCROLLBAR ─── */
.custom-scroll::-webkit-scrollbar,
.custom-scrollbar::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}

.custom-scroll::-webkit-scrollbar-track,
.custom-scrollbar::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.01);
}

.custom-scroll::-webkit-scrollbar-thumb,
.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(0, 242, 255, 0.3);
  border-radius: 10px;
  box-shadow: inset 0 0 5px rgba(0, 242, 255, 0.2);
}

.custom-scroll::-webkit-scrollbar-thumb:hover,
.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 242, 255, 0.6);
}

.custom-scroll,
.custom-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: rgba(0, 242, 255, 0.15) transparent;
}

/* ─── NEBULA BACKGROUND ─── */
.nebula-bg {
  position: fixed;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 15% 15%, rgba(0, 242, 255, 0.06) 0%, transparent 35%),
    radial-gradient(circle at 85% 85%, rgba(99, 102, 241, 0.06) 0%, transparent 35%),
    radial-gradient(circle at 50% 50%, rgba(16, 185, 129, 0.02) 0%, transparent 50%),
    var(--bg-deep);
  overflow: hidden;
}

.nebula-bg::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.01) 1px, transparent 1px),
    linear-gradient(rgba(255, 255, 255, 0.01) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: radial-gradient(circle at 50% 50%, black, transparent 80%);
  animation: grid-move 60s linear infinite;
}

@keyframes grid-move {
  from {
    transform: translateY(0);
  }

  to {
    transform: translateY(80px);
  }
}

.nebula-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
