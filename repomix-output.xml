        lkey = f"task_lock:{tid}"
        if tid != "man" and not redis_safe(lambda r: r.set(lkey, "busy", nx=True, ex=1800)): return {"status": "skipped"}
        try: return await self._run_mission(goal, tid, trid, data.get("mode", "fast"))
