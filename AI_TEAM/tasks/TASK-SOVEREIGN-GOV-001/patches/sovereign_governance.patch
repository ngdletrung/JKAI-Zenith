+    def validate_and_resolve_path(self, skill_name: str, category: str) -> Tuple[bool, str, str, str]:
+        """
+        [Step 2: PATH VALIDATION]
+        Kiểm tra chống Path Traversal tuyệt đối trên `skill_name` và `category`.
