+            if os.path.normcase(common) != os.path.normcase(self.skills_root):
+                return False, "", "", "PATH_TRAVERSAL_BLOCKED: Target directory escapes skills_root."
+        except ValueError:
+            return False, "", "", "PATH_TRAVERSAL_BLOCKED: Cross-drive path traversal."
