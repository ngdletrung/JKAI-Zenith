  "triggers": [
    "trinh sát",
    "điều tra",
    "investigate",
    "dossier build",
    "truy quét thực thể",
    "overview",
    "detailed features",
    "reasoning strategy",
    "strategic value",
    "edge cases   risks",
    "thuc",
    "trinh",
    "nang",
    "hoac",
    "dung",
    "phan",
    "hien",
    "thanh",
    "thong",
    "chung",
    "skill",
    "agent",
    "tac vu",
    "nhiem vu",
    "xu ly"
  ],
  "domain": "CORE",
  "schema": {
    "input": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "string",
