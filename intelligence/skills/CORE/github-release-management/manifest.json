{
  "id": "GITHUB_RELEASE_MANAGEMENT",
  "name": "Zenith GitHub Release Management",
  "version": "1.0.0",
  "description": "Deployment orchestrator: Manages software versions, tags, changelogs, and release assets on GitHub.",
  "author": "Zenith Kernel",
  "triggers": [
    "phát hành phần mềm",
    "github release",
    "quản lý version",
    "tạo changelog",
    "overview",
    "detailed features",
    "reasoning strategy",
    "strategic value",
    "edge cases   risks",
    "dung",
    "phien",
    "phat",
    "hanh",
    "release",
    "nang",
    "nguoi",
    "thay",
    "trinh",
    "phan",
    "skill",
    "agent",
    "tac vu",
    "nhiem vu",
    "xu ly"
  ],
  "domain": "CORE",
  "schema": {
    "input": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "Release version (e.g., v1.0.0)."
        }
      }
    }
  }
}