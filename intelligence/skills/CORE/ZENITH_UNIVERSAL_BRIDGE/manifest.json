{
  "id": "ZENITH_UNIVERSAL_BRIDGE",
  "name": "Zenith Universal Bridge",
  "name_vn": "**Cầu nối Vạn năng**: Giao thức kết nối nơ-ron đa tầng (MCP-Inside).",
  "version": "1.0.0",
  "author": "JKAI ZENITH Forge",
  "domain": "CORE",
  "priority": "HIGHEST",
  "description": "Cung cấp hạ tầng kết nối trực tiếp giữa các kỹ năng, cho phép trao đổi ngữ cảnh và kết quả mà không cần thông qua Orchestrator trung tâm.",
  "intent_pairs": [
    [
      "BRIDGE",
      "CONNECT"
    ],
    [
      "SYNC",
      "CONTEXT"
    ]
