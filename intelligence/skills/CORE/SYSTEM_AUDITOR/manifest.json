    "reasoning strategy",
    "strategic value",
    "edge cases   risks",
    "nang",
    "registry",
    "zenith",
    "thuc",
    "thong",
    "khong",
    "hien",
    "dossier",
    "toan",
    "skill",
    "agent",
    "tac vu",
    "nhiem vu",
    "xu ly"
