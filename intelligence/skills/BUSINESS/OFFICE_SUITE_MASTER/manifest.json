{
  "id": "OFFICE_SUITE_MASTER",
  "name": "Zenith Office Suite Master",
  "version": "1.0.0",
  "description": "Professional document production core: Advanced handling, styling, and generation of Microsoft Word and Excel documents with industrial precision.",
  "author": "Zenith Kernel",
  "triggers": [
    "viết word",
    "tạo excel",
    "đọc tài liệu văn phòng",
    "office master",
    "xử lý văn bản chuyên nghiệp",
    "overview",
    "detailed features",
    "reasoning strategy",
    "strategic value",
    "edge cases   risks",
    "chuyen",
    "lieu",
    "dang",
    "word",
    "bang",
    "phong",
    "office",
    "master",
    "excel",
    "nghiep",
    "kinh doanh",
    "ban hang",
    "marketing",
    "khach hang",
    "san pham"
  ],
  "domain": "BUSINESS",
  "schema": {
    "input": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "read",
            "read_file",
            "write_word",
            "create_word",
            "docx",
            "edit_word",
            "write_excel",
            "create_excel",
            "xlsx",
            "edit_excel",
            "write_pdf",
            "create_pdf",
            "pdf",
            "add_chart",
            "create_chart",
            "chart",
            "create_document",
            "plan_dossier"
          ],
          "description": "Office task to perform."
        },
        "title": {
          "type": "string",
          "description": "Title for Word document."
        },
        "content": {
          "type": "string",
          "description": "Content for Word document or PDF."
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Data for Excel sheet or chart."
        },
        "columns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Column names for Excel table."
        },
        "rows": {
          "type": "array",
          "items": { "type": "array" },
          "description": "Row values for Excel table."
        },
        "filename": {
          "type": "string",
          "description": "Base filename for the output."
        },
        "file_path": {
          "type": "string",
          "description": "Path to existing file for read/edit."
        },
        "goal": {
          "type": "string",
          "description": "User intent for auto/plan_dossier actions."
        }
      },
      "required": [
        "action"
      ]
    }
  }
}