{
  "mcpServers": {
    "jkai": {
      "command": "python",
      "args": ["${workspaceFolder}/tools/jkai-mcp/server.py"],
      "env": {
        "JKAI_BRAIN_URL": "http://localhost:8001",
        "JKAI_CONTROL_PLANE_URL": "http://localhost:7000",
        "JKAI_MCP_TIMEOUT": "600",
        "JKAI_LOCAL_ONLY_MODE": "1"
      }
    }
  }
}

