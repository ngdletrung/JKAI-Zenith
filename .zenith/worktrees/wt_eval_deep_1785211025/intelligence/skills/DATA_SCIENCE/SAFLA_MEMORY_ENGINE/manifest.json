  "domain": "DATA_SCIENCE",
  "schema": {
    "input": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "assimilate",
            "recall",
            "forge_concept"
          ],
          "description": "Memory action."
        },
        "text": {
          "type": "string",
          "description": "Text to assimilate or query to recall."
        },
        "tier": {
          "type": "string",
          "enum": [
            "semantic",
            "episodic"
          ],
          "description": "Memory tier for assimilation."
        }
      },
      "required": [
        "action"
      ]
    }
  }
