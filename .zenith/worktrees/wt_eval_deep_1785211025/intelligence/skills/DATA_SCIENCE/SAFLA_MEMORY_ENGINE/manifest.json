    "reasoning strategy",
    "strategic value",
    "edge cases   risks",
    "memory",
    "thuc",
    "thanh",
    "khong",
    "master",
    "hoac",
    "kinh",
    "zenith",
    "lieu",
    "tang",
    "data",
    "du lieu",
