  "author": "Zenith Kernel",
  "triggers": [
    "tối ưu hiệu năng v3",
    "flash attention",
    "hnsw search",
    "tăng tốc hệ thống",
    "tối ưu context",
    "overview",
    "detailed features",
    "reasoning strategy",
    "strategic value",
    "edge cases   risks",
    "performance",
    "context",
    "thong",
    "kiem",
    "luon",
    "master",
    "nhat",
    "nang",
    "thuc",
    "search",
    "deploy",
    "pipeline",
    "ci cd",
    "git",
    "commit"
  ],
  "domain": "DEVOPS",
  "schema": {
    "input": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "optimize_context",
            "hyper_search",
            "performance_audit"
