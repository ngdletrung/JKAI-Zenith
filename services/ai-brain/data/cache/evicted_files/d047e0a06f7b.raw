@dataclass
class ThreatScanResult:
    threat_level: str  # SAFE, SUSPICIOUS, MALICIOUS
    detected_patterns: List[str] = field(default_factory=list)
    sanitized_prompt: str = ""
    is_blocked: bool = False
    reason: str = ""
    scan_time_ms: float = 0.0


